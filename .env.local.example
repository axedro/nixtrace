# NIxTrace — environment variables
# Copy this file to .env.local and fill in your values.

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon/public key (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key — used only by the local seed script.
# NEVER expose this in the frontend or commit it to the repo.
# For cloud seeding, add this to GitHub Secrets as SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
